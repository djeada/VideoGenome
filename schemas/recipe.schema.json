{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VideoGenome procedural recipe v0.1",
  "description": "A parameterised, deterministic media generator. Models tweak params and presets, never code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipe_schema",
    "id",
    "version",
    "title",
    "description",
    "media",
    "runtime",
    "entry",
    "params",
    "license"
  ],
  "properties": {
    "recipe_schema": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*\\.[a-z0-9][a-z0-9.-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "audio",
          "image",
          "video"
        ]
      }
    },
    "runtime": {
      "enum": [
        "python",
        "browser"
      ]
    },
    "entry": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\.(py|html)$"
    },
    "params": {
      "type": "object",
      "required": [
        "type",
        "properties",
        "additionalProperties"
      ],
      "description": "JSON Schema for tweakable parameters; every property needs a default and description.",
      "properties": {
        "type": {
          "const": "object"
        },
        "additionalProperties": {
          "const": false
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "default",
              "description"
            ]
          }
        }
      }
    },
    "presets": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "license": {
      "type": "string",
      "minLength": 2
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seconds_per_output_second": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
