{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VideoGenome pipeline profile v0.1",
  "description": "Operator-owned composition of providers, renderer, analyzers and exporters. Never supplied by a job.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pipeline_schema",
    "id",
    "description",
    "verification"
  ],
  "$defs": {
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "config": {
          "type": "object"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "capability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "route": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chain"
          ],
          "properties": {
            "chain": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/step"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fallback"
          ],
          "properties": {
            "fallback": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "pipeline_schema": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]+$"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "verification": {
      "type": "string",
      "minLength": 5,
      "description": "How this profile was verified, e.g. 'CI', 'manual 2026-10-11 with piper-tts 1.3', 'unverified example'"
    },
    "extends": {
      "type": "string",
      "description": "Profile id or path whose providers/routes this one inherits"
    },
    "providers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/plugin"
      }
    },
    "routes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/route"
      }
    },
    "voices": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "styles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "renderer": {
      "$ref": "#/$defs/plugin"
    },
    "analyzers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plugin"
      }
    },
    "exporters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plugin"
      }
    }
  }
}
