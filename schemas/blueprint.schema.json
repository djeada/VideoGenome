{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VideoGenome blueprint v0.1 / v0.2",
  "description": "Portable, renderer-independent, human-reviewable video production recipe.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "category",
    "description",
    "inputs",
    "style",
    "output",
    "engines",
    "scenes",
    "rules",
    "quality_gates"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "0.1.0",
        "0.2.0"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "category": {
      "type": "string",
      "minLength": 2
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/input"
      }
    },
    "style": {
      "$ref": "#/$defs/style"
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "engines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_scene_reordering",
        "locked_elements"
      ],
      "properties": {
        "allow_scene_reordering": {
          "type": "boolean"
        },
        "locked_elements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "quality_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "timeline": {
      "$ref": "#/$defs/timeline"
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description",
        "required"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "string_array",
            "number",
            "boolean",
            "image",
            "image_array",
            "video",
            "video_array",
            "audio",
            "url"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 3
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mood",
        "palette",
        "typography",
        "pacing"
      ],
      "properties": {
        "mood": {
          "type": "string"
        },
        "palette": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "typography": {
          "type": "string"
        },
        "pacing": {
          "enum": [
            "slow",
            "measured",
            "dynamic",
            "fast",
            "variable"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps",
        "captions"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320
        },
        "height": {
          "type": "integer",
          "minimum": 320
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "captions": {
          "type": "boolean"
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "duration_frames",
        "shots"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "role": {
          "type": "string",
          "minLength": 2
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shot"
          }
        },
        "audio": {
          "$ref": "#/$defs/audio"
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "duration_frames",
        "direction"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "kind": {
          "enum": [
            "footage",
            "talking_head",
            "screen_capture",
            "generated_video",
            "motion_graphics",
            "still_image",
            "3d",
            "animation",
            "composite"
          ]
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1
        },
        "engine_hint": {
          "type": "string"
        },
        "input_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "direction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "type": "string",
              "minLength": 3
            },
            "framing": {
              "type": "string"
            },
            "camera_move": {
              "type": "string"
            },
            "lighting": {
              "type": "string"
            },
            "text_template": {
              "type": "string"
            },
            "prompt_template": {
              "type": "string"
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voiceover_template": {
          "type": "string"
        },
        "music_direction": {
          "type": "string"
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "mode": {
          "enum": [
            "automated",
            "human"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "audio_track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input_ref",
        "start_frame",
        "duration_frames"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "input_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1
        },
        "in_frame": {
          "type": "integer",
          "minimum": 0
        },
        "gain_db": {
          "type": "number",
          "minimum": -60,
          "maximum": 12
        },
        "fade_in_frames": {
          "type": "integer",
          "minimum": 0
        },
        "fade_out_frames": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "caption_cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start_frame",
        "duration_frames",
        "text_template"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1
        },
        "text_template": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "caption_style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "font_size",
        "margin_x",
        "margin_bottom",
        "max_chars_per_line",
        "max_lines",
        "max_chars_per_second"
      ],
      "properties": {
        "font_size": {
          "type": "integer",
          "minimum": 16,
          "maximum": 144
        },
        "margin_x": {
          "type": "integer",
          "minimum": 12
        },
        "margin_bottom": {
          "type": "integer",
          "minimum": 12
        },
        "max_chars_per_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 80
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "max_chars_per_second": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_audio": {
          "enum": [
            "preserve",
            "mute"
          ]
        },
        "source_audio_gain_db": {
          "type": "number",
          "minimum": -60,
          "maximum": 12
        },
        "audio_tracks": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/audio_track"
          }
        },
        "captions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "style",
            "cues"
          ],
          "properties": {
            "style": {
              "$ref": "#/$defs/caption_style"
            },
            "cues": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/caption_cue"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.1.0"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "timeline"
          ]
        }
      }
    }
  ]
}
