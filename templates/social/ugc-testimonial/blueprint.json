{
  "schema_version": "0.5.0",
  "id": "social.ugc-testimonial",
  "version": "0.2.0",
  "title": "UGC testimonial short",
  "category": "social",
  "description": "Authentic vertical testimonial composed from talking-head footage, real b-roll and readable captions.",
  "tags": [
    "social",
    "ugc",
    "testimonial",
    "real-footage"
  ],
  "inputs": {
    "speaker_clip": {
      "type": "video",
      "description": "Consent-cleared real speaker footage",
      "required": true
    },
    "broll_clips": {
      "type": "video_array",
      "description": "Supporting footage with appropriate rights",
      "required": true
    },
    "hook_line": {
      "type": "string",
      "description": "Short opening claim, copied word for word from the participant's transcript",
      "required": true,
      "fill": "verbatim"
    },
    "testimonial_line": {
      "type": "string",
      "description": "The participant's own words from the transcript (an exact excerpt, at most about 69 characters)",
      "required": true,
      "fill": "verbatim"
    },
    "cta": {
      "type": "string",
      "description": "The approved call to action, exactly as approved",
      "required": true,
      "fill": "verbatim"
    }
  },
  "copy_examples": [
    {
      "brief": "Testimonial clip from Dana, who owns a bakery (release signed). Transcript: \"I used to spend Sunday nights on invoices. Now it takes me ten minutes on Monday morning, and I get my weekend back.\" Approved call to action: Try it free for 30 days.",
      "inputs": {
        "hook_line": "I used to spend Sunday nights on invoices.",
        "testimonial_line": "Now it takes me ten minutes on Monday morning",
        "cta": "Try it free for 30 days"
      },
      "note": "Every slot is an exact excerpt: the hook is the participant's problem in their words, the proof line is their result, and the call to action is the approved wording. Nothing is paraphrased or improved."
    }
  ],
  "style": {
    "mood": "natural, direct and personable",
    "palette": [
      "#111111",
      "#FFFFFF",
      "#FFE45C"
    ],
    "typography": "Bold mobile-first sans serif captions",
    "pacing": "fast"
  },
  "output": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "captions": true
  },
  "engines": [
    "editorial",
    "ffmpeg",
    "remotion"
  ],
  "scenes": [
    {
      "id": "hook",
      "role": "attention",
      "duration_frames": 120,
      "shots": [
        {
          "id": "speaker_hook",
          "kind": "talking_head",
          "duration_frames": 120,
          "direction": {
            "action": "Use the participant's real hook; keep performance natural",
            "framing": "medium closeup with headroom",
            "text_template": "{{hook_line}}"
          },
          "engine_hint": "editorial",
          "input_refs": [
            "speaker_clip",
            "hook_line"
          ]
        }
      ]
    },
    {
      "id": "proof",
      "role": "testimonial",
      "duration_frames": 360,
      "shots": [
        {
          "id": "speaker_proof",
          "kind": "talking_head",
          "duration_frames": 210,
          "direction": {
            "action": "Hold enough time for an intelligible real testimonial",
            "framing": "eye-level",
            "text_template": "{{testimonial_line}}"
          },
          "engine_hint": "editorial",
          "input_refs": [
            "speaker_clip",
            "testimonial_line"
          ]
        },
        {
          "id": "broll",
          "kind": "footage",
          "duration_frames": 150,
          "direction": {
            "action": "Show context-appropriate evidence with original audio preserved when helpful",
            "framing": "handheld cutaways"
          },
          "engine_hint": "editorial",
          "input_refs": [
            "broll_clips"
          ]
        }
      ]
    },
    {
      "id": "cta",
      "role": "close",
      "duration_frames": 150,
      "shots": [
        {
          "id": "cta_card",
          "kind": "motion_graphics",
          "duration_frames": 150,
          "direction": {
            "action": "Overlay the approved CTA on final footage or neutral color",
            "text_template": "{{cta}}",
            "framing": "above UI safe-zone"
          },
          "engine_hint": "remotion",
          "input_refs": [
            "cta"
          ]
        }
      ]
    }
  ],
  "rules": {
    "allow_scene_reordering": false,
    "locked_elements": [
      "style.typography"
    ],
    "notes": [
      "Do not synthesize or invent testimonials.",
      "Confirm consent, releases and usage rights before publication."
    ]
  },
  "quality_gates": [
    {
      "id": "authenticity",
      "mode": "human",
      "description": "Testimonial statements and edits accurately represent the real participant."
    },
    {
      "id": "caption_legibility",
      "mode": "automated",
      "description": "Caption text is within mobile UI safe zones and has sufficient contrast."
    },
    {
      "id": "rights_review",
      "mode": "human",
      "description": "Footage, likeness and music have the required permissions."
    }
  ],
  "timeline": {
    "source_audio": "preserve",
    "captions": {
      "style": {
        "font_size": 40,
        "margin_x": 72,
        "margin_bottom": 420,
        "max_chars_per_line": 23,
        "max_lines": 3,
        "max_chars_per_second": 17
      },
      "cues": [
        {
          "id": "hook",
          "start_frame": 6,
          "duration_frames": 108,
          "text_template": "{{hook_line}}"
        },
        {
          "id": "proof",
          "start_frame": 126,
          "duration_frames": 198,
          "text_template": "{{testimonial_line}}"
        }
      ]
    }
  }
}
