{
  "recipe_schema": "0.1.0",
  "id": "visual.aurora",
  "version": "0.1.0",
  "title": "Aurora gradient",
  "description": "A slowly flowing, domain-warped gradient in a locked palette with soft glow, vignette and film grain. Calm, premium backgrounds for title cards, lower thirds and social posts.",
  "media": [
    "video",
    "image"
  ],
  "runtime": "python",
  "entry": "aurora.py",
  "params": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "palette": {
        "type": "array",
        "minItems": 2,
        "maxItems": 6,
        "items": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "default": [
          "#0B1020",
          "#1B3A6B",
          "#3DBEA8",
          "#F2C14E"
        ],
        "description": "Colour stops from dark to light, mixed perceptually (OKLab)"
      },
      "speed": {
        "type": "number",
        "minimum": 0,
        "maximum": 2,
        "default": 0.05,
        "description": "Flow speed; 0 freezes the field"
      },
      "frequency": {
        "type": "number",
        "minimum": 0.2,
        "maximum": 6,
        "default": 0.75,
        "description": "Feature size: low = broad soft shapes, high = busy"
      },
      "warp": {
        "type": "number",
        "minimum": 0,
        "maximum": 2,
        "default": 0.45,
        "description": "Domain-warp strength: how liquid the shapes look"
      },
      "contrast": {
        "type": "number",
        "minimum": 0.3,
        "maximum": 2.5,
        "default": 1.0,
        "description": "Spread across the palette"
      },
      "brightness": {
        "type": "number",
        "minimum": 0.2,
        "maximum": 1.6,
        "default": 0.85,
        "description": "Overall exposure"
      },
      "glow": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.2,
        "description": "Extra light in the brightest ridges"
      },
      "flow_angle": {
        "type": "number",
        "minimum": -180,
        "maximum": 180,
        "default": 25,
        "description": "Drift direction in degrees"
      },
      "vignette": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.45,
        "description": "Edge darkening"
      },
      "grain": {
        "type": "number",
        "minimum": 0,
        "maximum": 0.12,
        "default": 0.025,
        "description": "Film grain amount (also prevents banding)"
      },
      "detail_scale": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 1,
        "default": 0.25,
        "description": "Internal resolution factor; higher is sharper and slower"
      }
    }
  },
  "presets": {
    "calm": {
      "speed": 0.035,
      "warp": 0.35,
      "frequency": 0.6,
      "glow": 0.12
    },
    "vivid": {
      "palette": [
        "#120B2E",
        "#5B2A86",
        "#E2557B",
        "#FFB86B"
      ],
      "speed": 0.07,
      "warp": 0.6,
      "frequency": 0.9,
      "contrast": 1.25,
      "glow": 0.3
    },
    "midnight": {
      "palette": [
        "#05070D",
        "#0E1A33",
        "#21406B",
        "#6E8BB8"
      ],
      "brightness": 0.8,
      "glow": 0.2,
      "vignette": 0.6
    },
    "forest": {
      "palette": [
        "#07130E",
        "#123524",
        "#2F6B4F",
        "#C9D88A"
      ]
    },
    "sunrise": {
      "palette": [
        "#2B1B3D",
        "#B4436C",
        "#F78154",
        "#FFD38C"
      ],
      "brightness": 0.95,
      "contrast": 1.15
    }
  },
  "tags": [
    "background",
    "gradient",
    "calm",
    "brand",
    "loopable-feel"
  ],
  "license": "MIT",
  "authors": [
    "VideoGenome contributors"
  ],
  "notes": [
    "Pair with a background_dim of 0.2-0.4 behind white type.",
    "All motion is a function of the frame index, so any frame can be rendered alone."
  ],
  "cost": {
    "seconds_per_output_second": 2.5
  }
}
