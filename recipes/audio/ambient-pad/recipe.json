{
  "recipe_schema": "0.1.0",
  "id": "audio.ambient-pad",
  "version": "0.1.0",
  "title": "Ambient pad bed",
  "description": "A slow, voice-led chord progression with warm detuned pads, sub bass, sparse bell sparkles and a large reverb. Sits under narration without competing with it.",
  "media": ["audio"],
  "runtime": "python",
  "entry": "ambient_pad.py",
  "params": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "key": {"enum": ["C", "C#", "D", "Eb", "E", "F", "F#", "G", "Ab", "A", "Bb", "B"], "default": "D", "description": "Tonal centre"},
      "mode": {"enum": ["major", "minor", "dorian", "lydian", "mixolydian"], "default": "lydian", "description": "Scale colour: lydian = hopeful, dorian = reflective, minor = serious"},
      "bpm": {"type": "number", "minimum": 40, "maximum": 120, "default": 70, "description": "Tempo; sets chord length and sparkle rhythm"},
      "progression": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "integer", "minimum": 1, "maximum": 7},
                      "default": [1, 5, 6, 4], "description": "Scale degrees, one chord each"},
      "bars_per_chord": {"type": "integer", "minimum": 1, "maximum": 4, "default": 2, "description": "How long each chord rings"},
      "brightness": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.4, "description": "Pad tone: 0 = dark and soft, 1 = open and airy"},
      "sparkle": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.45, "description": "Density of bell sparkles"},
      "bass": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.6, "description": "Sub bass level"},
      "reverb": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.55, "description": "Room size and wetness"},
      "air": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.3, "description": "Faint high noise layer for texture"},
      "width": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.6, "description": "Stereo spread of the pad voices"},
      "warmth": {"type": "number", "minimum": 0, "maximum": 0.6, "default": 0.15, "description": "Gentle saturation on the master"}
    }
  },
  "presets": {
    "hopeful": {"mode": "lydian", "progression": [1, 5, 6, 4], "brightness": 0.5},
    "reflective": {"key": "A", "mode": "dorian", "progression": [1, 4, 7, 4], "brightness": 0.3, "sparkle": 0.3},
    "serious": {"key": "C", "mode": "minor", "progression": [1, 6, 3, 7], "brightness": 0.25, "sparkle": 0.2, "bpm": 60},
    "dreamy": {"key": "E", "mode": "major", "progression": [1, 3, 4, 4], "reverb": 0.85, "sparkle": 0.7, "brightness": 0.55},
    "warm": {"key": "F", "mode": "major", "progression": [1, 6, 2, 5], "brightness": 0.35, "warmth": 0.3}
  },
  "tags": ["music", "bed", "ambient", "narration", "calm"],
  "license": "MIT",
  "authors": ["VideoGenome contributors"],
  "notes": ["Mix it about 18-24 dB under narration, or let timeline ducking handle it."],
  "cost": {"seconds_per_output_second": 0.15}
}
